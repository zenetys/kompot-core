define service {
  check_command        check-dummy
  __CRIT               95
  register             0
  name                 my-check
  use                  generic-service
}
#### _os ####
define host {
  register             0
  name                 _os
  use                  generic-host
}

#### _linux:_os ####
define host {
  register             0
  name                 _linux
  use                  _os
}
define service {
  __CRIT               22
  register             0
  name                 my-check__1
  use                  my-check
}

#### server1:_linux ####
define host {
  host_name            server1
  display_name         server1
  address              10.0.0.1
  use                  _linux
}
define service {
  service_description  MY-CHECK
  display_name         MY-CHECK
  host_name            server1
  use                  _os:my-check
}

define service {
  register             0
  name                 _os:my-check
  display_name         MY-CHECK
  use                  my-check__1
}
